# User/group IDs that own the music Aurral writes under ./data/music.
# `id -u` and `id -g` on the host running docker.
PUID=1000
PGID=1000

# Set true only if Aurral sits behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# Host-side port. The default matches Aurral's.
# Override (e.g. AURRAL_PORT=3101) if that port is already taken on this host
# by your real Aurral.
AURRAL_PORT=3001
